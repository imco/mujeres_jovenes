# Contraseña para proteger el endpoint POST /api/sync
ADMIN_PASSWORD=cambia_esto_por_una_clave_segura

# Token de Vercel Blob (se obtiene en el dashboard de Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Asistente de IA (api/chat.js): clave de la API de Gemini (AI Studio o Google Cloud)
GEMINI_API_KEY=
# Opcional: modelos en orden de preferencia, separados por coma (ver api/chat.js)
GEMINI_MODELS=
